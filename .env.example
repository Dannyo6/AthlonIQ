# ==============================================================================
# AthlonIQ — Environment Configuration Template
# ==============================================================================

# API Configuration (Backend - FastAPI)
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
PROJECT_NAME="AthlonIQ API"
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Supabase & Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# AI Services Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7

# Frontend Configuration (Vite - Accessible via import.meta.env)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
VITE_APP_NAME="AthlonIQ"
VITE_APP_TAGLINE="Personal AI Performance & Physique OS"
