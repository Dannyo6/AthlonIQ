# ==============================================================================
# AthlonIQ — Environment Configuration Template
# ==============================================================================

# API Configuration (Backend - FastAPI)
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
PROJECT_NAME="AthlonIQ API"
# Dev defaults stay the three localhost origins:
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
# To allow mobile/LAN device testing on your local network, add the LAN origin (placeholder-style, JSON list format):
# BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://192.168.29.8:5173"]

# Supabase & Database Configuration (Backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# AI Services Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7

# Frontend Configuration (Vite - Accessible via import.meta.env in web/.env.local)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_APP_NAME="AthlonIQ"
VITE_APP_TAGLINE="Personal AI Performance & Physique OS"
